<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/screen_background"
    android:padding="16dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Executive Manager Portal"
        android:textColor="@color/primary_brown"
        android:textSize="22sp"
        android:textStyle="bold"
        android:layout_marginBottom="16dp"/>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Pending Registrations Section (Real-time) -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                app:cardCornerRadius="16dp"
                app:cardBackgroundColor="@color/white">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Staff Registration Requests"
                        android:textColor="@color/text_primary"
                        android:textStyle="bold" />

                    <LinearLayout
                        android:id="@+id/layout_pending_users"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:layout_marginTop="8dp" />
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- Financial Card Summary -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                app:cardCornerRadius="16dp"
                app:cardBackgroundColor="@color/white">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Financial Oversight"
                        android:textColor="@color/text_primary"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tv_revenue_summary"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Daily Revenue: R0.00\nExpenses: R0.00\nNet Profit: R0.00"
                        android:textColor="@color/text_secondary"
                        android:layout_marginTop="12dp" />

                    <TextView
                        android:id="@+id/tv_meal_stats"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Meal Trend: Burgers (Stable)"
                        android:textColor="@color/primary_brown"
                        android:textSize="12sp"
                        android:layout_marginTop="8dp" />
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- Shift Scheduling -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                app:cardCornerRadius="16dp"
                app:cardBackgroundColor="@color/white">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Staff Shift Management"
                        android:textColor="@color/text_primary"
                        android:textStyle="bold" />

                    <EditText
                        android:id="@+id/et_worker_uid"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="Worker UID"
                        android:textSize="14sp"
                        android:layout_marginTop="8dp" />

                    <EditText
                        android:id="@+id/et_shift_hours"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="Hours"
                        android:inputType="number"
                        android:textSize="14sp" />

                    <EditText
                        android:id="@+id/et_pay_rate"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="Pay Rate (R/hr)"
                        android:inputType="numberDecimal"
                        android:textSize="14sp" />

                    <Button
                        android:id="@+id/btn_assign_shift"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Publish Timetable"
                        android:backgroundTint="@color/primary_brown"
                        android:layout_marginTop="8dp" />
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- Management Actions -->
            <Button
                android:id="@+id/btn_manage_stock"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Update Stock Levels"
                android:backgroundTint="@color/primary_brown"
                android:layout_marginBottom="8dp" />

            <Button
                android:id="@+id/btn_manage_ads"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Manage Marketing Ads"
                android:backgroundTint="@color/primary_brown"
                android:layout_marginBottom="16dp" />

            <!-- Feedback Display -->
            <TextView
                android:id="@+id/tv_complaints_view"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="No customer feedback logged today."
                android:textColor="@color/text_secondary"
                android:layout_marginBottom="24dp" />

        </LinearLayout>
    </ScrollView>

    <Button
        android:id="@+id/btn_manager_logout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Sign Out"
        android:backgroundTint="@color/bottom_nav_inactive"/>
</LinearLayout>
