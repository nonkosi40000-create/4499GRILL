<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/screen_background"
    android:padding="16dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Worker Operational Portal"
        android:textColor="@color/primary_brown"
        android:textSize="22sp"
        android:textStyle="bold"
        android:layout_marginBottom="16dp"/>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Work Schedule & Pay -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                app:cardCornerRadius="16dp"
                app:cardBackgroundColor="@color/white">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Your Shifts &amp; Estimated Pay"
                        android:textColor="@color/text_primary"
                        android:textStyle="bold" />
                    <TextView
                        android:id="@+id/tv_worker_schedule"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Fetching your schedule..."
                        android:textColor="@color/text_secondary"
                        android:layout_marginTop="8dp" />
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- Menu & Ad Uploads -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                app:cardCornerRadius="16dp"
                app:cardBackgroundColor="@color/white">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Content Creation (Ads/Items)"
                        android:textColor="@color/text_primary"
                        android:textStyle="bold" />
                    <EditText
                        android:id="@+id/et_menu_item_name"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="Item/Ad Title"
                        android:layout_marginTop="8dp"
                        android:textSize="14sp" />
                    <EditText
                        android:id="@+id/et_menu_item_price"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="Price (if applicable)"
                        android:inputType="numberDecimal"
                        android:textSize="14sp" />
                    <EditText
                        android:id="@+id/et_menu_item_desc"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="Description / Video URL"
                        android:textSize="14sp" />
                    <Button
                        android:id="@+id/btn_upload_menu"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Upload Content"
                        android:backgroundTint="@color/primary_brown"
                        android:layout_marginTop="8dp" />
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- Customer Interaction -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                app:cardCornerRadius="16dp"
                app:cardBackgroundColor="@color/white">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Customer Service Terminal"
                        android:textColor="@color/text_primary"
                        android:textStyle="bold" />

                    <EditText
                        android:id="@+id/et_notify_order_id"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="Order ID for alert"
                        android:layout_marginTop="8dp"
                        android:textSize="14sp" />

                    <Button
                        android:id="@+id/btn_notify_stock_issue"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Notify Out of Stock"
                        android:backgroundTint="#D32F2F"
                        android:layout_marginTop="8dp" />

                    <Button
                        android:id="@+id/btn_open_chat"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Open Support Chat"
                        android:backgroundTint="@color/primary_brown"
                        android:layout_marginTop="4dp" />
                </LinearLayout>
            </androidx.cardview.widget.CardView>

        </LinearLayout>
    </ScrollView>

    <Button
        android:id="@+id/btn_worker_logout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Sign Out"
        android:backgroundTint="@color/bottom_nav_inactive"
        android:layout_marginTop="8dp"/>
</LinearLayout>
